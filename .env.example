# Порт веб-сервера
PORT=3000

# Подключение к Microsoft SQL Server (SQL-аутентификация)
DB_SERVER=localhost
DB_PORT=1433
# Для именованного экземпляра (например, SQLEXPRESS) укажите его имя — тогда DB_PORT не используется
# DB_INSTANCE=SQLEXPRESS
DB_NAME=BookShelf
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Секрет для подписи JWT — замените на длинную случайную строку
JWT_SECRET=change-me-to-a-long-random-string
# true — cookie только по HTTPS
COOKIE_SECURE=false
